#!/bin/bash

# 🚀 Free-Tier Optimized AI Deployment
# Lightweight, Cost-Effective AI Deployment on AWS Free Tier

# --- CONFIGURATION ---
AWS_REGION="us-east-1"
S3_BUCKET_AI="ai-insights-free-tier-$RANDOM"
DYNAMODB_TABLE="AI_NodeStatusTable_FreeTier"
IAM_ROLE_NAME="AIProcessingRole_FreeTier"
INSTANCE_TYPE="t2.micro"  # Free Tier EC2
LAMBDA_FUNCTION_NAME="AI_NodeProcessor_FreeTier"
SECURITY_GROUP_NAME="AI-SecurityGroup-FreeTier"
KEY_PAIR_NAME="AI-Deployment-Key-FreeTier"
EC2_AMI="ami-09e67e426f25ce0d7"
K8S_NAMESPACE="ai-system-free-tier"
K8S_REPLICAS=1  # Reduce resource consumption
ENABLE_GPU=false
KUBE_CONFIG="$HOME/.kube/config"

# --- ERROR HANDLING ---
set -e
trap 'echo "⚠️ ERROR at line $LINENO: $BASH_COMMAND" && exit 1' ERR

# --- INSTALL DEPENDENCIES ---
echo "🔧 Installing dependencies..."
sudo apt update && sudo apt install -y awscli kubectl jq docker.io

# --- CONFIGURE AWS ---
echo "🔐 Configuring AWS..."
aws configure set region $AWS_REGION

# --- CREATE SECURE S3 BUCKET ---
echo "🪣 Creating Secure S3 Bucket: $S3_BUCKET_AI..."
aws s3api create-bucket --bucket "$S3_BUCKET_AI" --region "$AWS_REGION" \
    --create-bucket-configuration LocationConstraint="$AWS_REGION"

aws s3api put-bucket-encryption --bucket "$S3_BUCKET_AI" \
    --server-side-encryption-configuration '{
        "Rules": [{"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
    }'

# --- CREATE DYNAMODB TABLE ---
echo "📊 Creating DynamoDB Table: $DYNAMODB_TABLE..."
aws dynamodb create-table --table-name "$DYNAMODB_TABLE" \
    --attribute-definitions AttributeName=NodeID,AttributeType=S \
    --key-schema AttributeName=NodeID,KeyType=HASH \
    --billing-mode PAY_PER_REQUEST

# --- CREATE IAM ROLE ---
echo "🔐 Creating IAM Role: $IAM_ROLE_NAME..."
aws iam create-role --role-name "$IAM_ROLE_NAME" \
    --assume-role-policy-document '{
        "Version": "2012-10-17",
        "Statement": [{
            "Effect": "Allow",
            "Principal": {"Service": ["ec2.amazonaws.com", "lambda.amazonaws.com"]},
            "Action": "sts:AssumeRole"
        }]
    }'

aws iam attach-role-policy --role-name "$IAM_ROLE_NAME" --policy-arn arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess
aws iam attach-role-policy --role-name "$IAM_ROLE_NAME" --policy-arn arn:aws:iam::aws:policy/AmazonDynamoDBReadOnlyAccess
aws iam attach-role-policy --role-name "$IAM_ROLE_NAME" --policy-arn arn:aws:iam::aws:policy/CloudWatchLogsReadOnlyAccess

ROLE_ARN=$(aws iam get-role --role-name "$IAM_ROLE_NAME" --query 'Role.Arn' --output text)

# --- CREATE SECURITY GROUP ---
echo "🔒 Creating Security Group: $SECURITY_GROUP_NAME..."
SECURITY_GROUP_ID=$(aws ec2 create-security-group --group-name "$SECURITY_GROUP_NAME" \
    --description "Security group for AI Processing" --query 'GroupId' --output text)

aws ec2 authorize-security-group-ingress --group-id "$SECURITY_GROUP_ID" --protocol tcp --port 22 --cidr 0.0.0.0/0

# --- DEPLOY KUBERNETES CLUSTER ---
echo "🔧 Deploying Kubernetes Cluster (Minimized)..."
curl -s https://get.k3s.io | sh
kubectl create namespace $K8S_NAMESPACE

# --- DEPLOY LIGHTWEIGHT MONITORING SYSTEM ---
echo "📊 Deploying Lightweight Monitoring..."
kubectl apply -f monitoring/prometheus-minimal.yaml
kubectl apply -f monitoring/grafana-minimal.yaml

# --- DEPLOY LIGHT AI MODEL SERVERS ---
echo "🧠 Deploying AI Model Servers (Optimized for Free Tier)..."
kubectl apply -f k8s/model-server-light.yaml
kubectl apply -f k8s/api-gateway-light.yaml

# --- CONFIGURE MINIMAL AUTOSCALING ---
echo "⚙️ Configuring Free-Tier Autoscaling..."
kubectl apply -f k8s/hpa-model-light.yaml

# --- DEPLOY AI SYSTEM TO FREE-TIER EC2 ---
echo "🚀 Deploying AI System to Free-Tier EC2..."
aws s3 cp ai_system_light.zip s3://$S3_BUCKET_AI/
ssh -i "$KEY_PAIR_NAME.pem" ec2-user@$INSTANCE_ID << EOF
  sudo yum install -y python3-pip
  pip3 install boto3 numpy flask torch
  aws s3 cp s3://$S3_BUCKET_AI/ai_system_light.zip /home/ec2-user/
  unzip /home/ec2-user/ai_system_light.zip
  python3 /home/ec2-user/start_ai.py &
EOF

# --- RUN PERFORMANCE TESTS ---
echo "🏎️ Running Free-Tier Performance Benchmark..."
python3 performance-test.py --free-tier

# --- DEPLOY LAMBDA FUNCTION ---
echo "🔄 Deploying AWS Lambda Function..."
ZIP_FILE="lambda_function_free_tier.zip"
zip -j "$ZIP_FILE" ./lambda_function_light.py

aws lambda create-function --function-name "$LAMBDA_FUNCTION_NAME" \
    --runtime python3.9 --role "$ROLE_ARN" --handler lambda_function_light.lambda_handler \
    --timeout 90 --memory-size 512 --zip-file fileb://$ZIP_FILE

# --- FINAL VERIFICATION ---
echo "✅ Free-Tier Deployment Completed Successfully!"
kubectl get pods -n $K8S_NAMESPACE
aws s3 ls s3://$S3_BUCKET_AI/
aws dynamodb describe-table --table-name $DYNAMODB_TABLE

